<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================= PERMISSIONS ============================= -->
    <!-- Legacy storage access (Android 12 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <!-- Modern media permissions (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>

    <!-- For url_launcher, video_player, and general network usage -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="Alight Creators"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">

        <!-- ======================= Flutter MainActivity ======================= -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Flutter process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ======================= uCrop (image_cropper 8.1.0) =======================
             Two facts about this block, both verified against the plugin source:

             1. The plugin's own AndroidManifest.xml declares NOTHING, so this
                declaration is mandatory. Without it you get
                "ActivityNotFoundException: Unable to find explicit activity class
                 {…/com.yalantis.ucrop.UCropActivity}". We DO declare it, so that
                was never our bug.

             2. The theme is the line that was wrong. image_cropper 8.1.0 ships
                "Ucrop.CropTheme" in its own res/values + res/values-v35, and on
                API 35 that style is the ONLY thing carrying
                android:windowOptOutEdgeToEdgeEnforcement="true". Pointing the
                activity at a bare Theme.AppCompat.* puts the cropper under
                forced edge-to-edge on Android 15, which is exactly the failure
                this plugin version added the style to work around.
        -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:theme="@style/Ucrop.CropTheme"/>

        <!-- No FileProvider here on purpose. image_cropper 8.1.0 hands uCrop
             plain file:// URIs (Uri.fromFile for source and for the cache-dir
             output) and reads the result back with a direct file path, and
             neither the plugin AAR nor the uCrop AAR declares a provider. An
             "${applicationId}.ucrop.fileprovider" entry would be dead weight,
             and a wrong one (missing @xml/ucrop_file_provider_paths) is a
             build failure, not a fix. -->

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- ============================= QUERIES =============================
         Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in
         io.flutter.plugin.text.ProcessTextPlugin.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Required so url_launcher can open https links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- Required so url_launcher can open mailto links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>